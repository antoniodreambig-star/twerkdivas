# Required
SESSION_SECRET=            # 16+ random characters (e.g. run: openssl rand -hex 24)
ADMIN_EMAIL=               # your login as the first admin
ADMIN_PASSWORD=            # first admin password (change by Set password later)
ADMIN_NAME=Cakes and Core
DATABASE_URL=              # Neon / Vercel Postgres connection string (omit only for local testing)
# Billing (Stripe)
STRIPE_SECRET_KEY=         # sk_live_... or sk_test_...
STRIPE_PRICE_ID=           # price_... of your MONTHLY recurring price
STRIPE_WEBHOOK_SECRET=     # whsec_... from the webhook endpoint below
# STRIPE_TAX=1             # optional: turn on Stripe automatic tax
# Email (password reset, ticket confirmations) via Brevo
BREVO_API_KEY=             # Brevo > SMTP & API > API keys
EMAIL_FROM=                # e.g. Cakes and Core <no-reply@twerkdivas.com> (verified sender in Brevo)
# APP_URL=https://app.twerkdivas.com   # optional: base URL used in emails
# Protected video (Mux signed playback), optional
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=  # base64 of the PEM private key
# APP_TZ=America/Chicago   # optional: default time zone for online classes

# --- Daily jobs (backups, review requests, waitlist sweep). Vercel Cron sends this as a Bearer token.
CRON_SECRET=
# Optional: where the daily backup email goes (defaults to ADMIN_EMAIL)
BACKUP_EMAIL=
# Optional: numeric Brevo list id to also add opted-in buyers to
BREVO_LIST_ID=
# Stripe Connect (automatic instructor payouts): enable Connect in the Stripe dashboard, and add the
# event "account.updated" (Connected accounts) to your webhook endpoint, along with checkout.session.completed/expired.
